# Copy to .env locally and fill secrets from your secret manager. Never commit .env.
CALL_PROVIDER=media_streams
DIALOGUE_MODE=ai
VOICE_TRANSPORT=media_streams
VOICE_STREAMING_ENABLED=true
PUBLIC_URL=https://your-public-host.example
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Speech-to-text
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
STT_PROVIDER=deepgram

# Speech generation. Aura and ElevenLabs are neural voices.
# For the most natural phone voice set TTS_PRIMARY=elevenlabs and ELEVENLABS_MODEL_ID=eleven_flash_v2_5.
# windows_sapi is a local fallback and sounds synthetic.
# DEEPGRAM_TTS_VOICE should be a voice-specific Aura model ID.
TTS_PRIMARY=deepgram
DEEPGRAM_TTS_MODEL=aura-2
DEEPGRAM_TTS_VOICE=aura-2-thalia-en
# Empty = no cross-provider fallback (keeps one voice for the whole call).
# List only providers whose voice matches DEEPGRAM_TTS_VOICE, e.g. elevenlabs.
TTS_FALLBACK_PROVIDERS=
# Empty = never use Twilio <Say>. Set only to a voice matching the TTS voice.
TWILIO_SAY_VOICE=

# LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Small model for simple validated turns (stable, listed at ai.google.dev/gemini-api/docs/models).
# Complex, denial, appeal and ambiguous turns stay on GEMINI_MODEL, which is also the fallback.
# Empty = all turns use GEMINI_MODEL.
GEMINI_SIMPLE_MODEL=gemini-3.5-flash-lite

# Optional TTS fallbacks (used only when listed in TTS_FALLBACK_PROVIDERS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=cjVigY5qzO86Huf0OWal
# eleven_flash_v2_5 is faster and, with low style, stays conversational.
# eleven_turbo_v2_5 is the higher-quality alternative if Flash sounds thin.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# LiveKit Cloud orchestration room. Phone audio stays on Twilio.
# Create a project at https://cloud.livekit.io and copy the websocket URL, key, and secret.
# Do not put the secret in source control.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Latency / VAD
VOICE_LATENCY_TARGET_MS=1200
SILENCE_TIMER_MS=240
VAD_ENABLED=true
VAD_PROVIDER=silero
SILERO_VAD_THRESHOLD=0.35
SILERO_VAD_MIN_SILENCE_MS=280
SILERO_VAD_SPEECH_PAD_MS=20
SMART_TONE_DETECTION_ENABLED=true
BACKCHANNEL_ENABLED=true

# Optional database / background tasks
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
CELERY_ENABLED=false
